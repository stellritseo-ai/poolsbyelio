# Copy to .env.local for local development. On Vercel, add the same keys under
# Project Settings → Environment Variables. NEVER commit real values.

# --- Canonical site origin (must match the primary domain set in Vercel) ---
NEXT_PUBLIC_SITE_URL=https://www.poolsbyelio.net

# --- Lead delivery (Zoho SMTP) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Pools By Elio Website"
SMTP_FROM_EMAIL=
LEAD_RECIPIENT_EMAIL=

# --- Analytics & webmaster verification (all optional; nothing loads if empty) ---
# Use EITHER GA4 directly OR GTM (with GA4 inside GTM) — not both.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

